# Copie para .env se quiser trocar as credenciais: cp .env.example .env
# Sem .env o compose usa estes mesmos valores como padrão.
# São credenciais de LABORATÓRIO. Não use em produção.

# Console do Hasura (http://localhost:8080/console) pede este admin secret
HASURA_ADMIN_SECRET=myadminsecretkey

# Postgres (exposto em localhost:8082)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=graphqlab
